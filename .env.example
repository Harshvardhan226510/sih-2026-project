PORT=3001
NODE_ENV=development

# ── API URL Configuration ──────────────────────────────────────────────
# In local development, leave empty to use Vite's local proxy.
# In production, point to the shared production alerts API.
VITE_ALERTS_API_URL=

# ── Supabase shared cross-module database ────────────────────────────────
# Production architecture now uses Supabase as the AUTHORITATIVE backend.

# Public credentials for frontend / read-only access (if needed)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Server credentials (used by the ingestion and sync backend)
SUPABASE_URL=https://<your-project>.supabase.co
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Ingestion and Provider config ────────────────────────────────────────
IMD_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
INGESTION_CRON=*/10 * * * *
LOG_LEVEL=info

# ── MQTT Configuration ───────────────────────────────────────────────────
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=weathergpt-server
MQTT_PASSWORD=secret
MQTT_CLIENT_ID=weathergpt-server
MQTT_TOPIC=weathergpt/alerts/#
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000

# ── Web Push / VAPID Configuration ───────────────────────────────────────
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
ADMIN_SECRET=test-secret
