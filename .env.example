# Server Configuration
PORT=3001
NODE_ENV=development
DB_PATH=./src/features/alerts/server/db/weathergpt.db
LOG_LEVEL=info

# Ingestion & External APIs
IMD_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
INGESTION_CRON=*/10 * * * *

# Frontend API URL (Optional, defaults to Vite proxy or http://localhost:3001)
# VITE_API_URL=http://localhost:3001

# MQTT Configuration
MQTT_ENABLED=false
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
MQTT_TOPIC=weathergpt/alerts/#
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000

# Web Push / VAPID Configuration
VAPID_SUBJECT=mailto:admin@weathergpt.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ADMIN_SECRET=test-secret

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
